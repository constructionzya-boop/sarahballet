# Stripe — checkout carte bancaire (mode test).
# Copier en `.env.local` et renseigner avec les clés du dashboard Stripe (test).

# Clé secrète serveur (jamais exposée au navigateur).
STRIPE_SECRET_KEY=sk_test_xxx

# Clé publiable (exposée au client — préfixe NEXT_PUBLIC_ obligatoire).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# Secret de signature des webhooks (via `stripe listen` ou le dashboard).
STRIPE_WEBHOOK_SECRET=whsec_xxx
